<Page x:Class="UnoWearables.CounterPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:UnoWearables"
      Background="{StaticResource WatchBackgroundBrush}">

  <Page.DataContext>
    <local:CounterViewModel />
  </Page.DataContext>

  <ScrollViewer VerticalScrollBarVisibility="Hidden"
                HorizontalScrollMode="Disabled">
    <StackPanel Padding="24,12"
                Spacing="6"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

      <Button AutomationProperties.AutomationId="BackButton"
              AutomationProperties.Name="Back"
              Style="{StaticResource WatchBackButtonStyle}"
              Click="OnBackClick">
        <FontIcon Glyph="&#xE72B;" FontSize="14" />
      </Button>

      <TextBlock Text="Counter"
                 FontSize="14"
                 HorizontalAlignment="Center"
                 Foreground="{StaticResource WatchSecondaryTextBrush}" />

      <TextBlock AutomationProperties.AutomationId="CountTextBlock"
                 Text="{Binding Count}"
                 FontSize="44"
                 FontWeight="SemiBold"
                 HorizontalAlignment="Center" />

      <Button AutomationProperties.AutomationId="IncrementButton"
              AutomationProperties.Name="Increment counter"
              Width="60" Height="60"
              CornerRadius="30"
              Padding="0"
              BorderThickness="0"
              HorizontalAlignment="Center"
              Background="{StaticResource WatchCounterBrush}"
              Foreground="Black"
              Command="{Binding IncrementCommand}">
        <FontIcon Glyph="&#xE710;" FontSize="22" />
      </Button>

    </StackPanel>
  </ScrollViewer>
</Page>
