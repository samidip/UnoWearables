<Application x:Class="UnoWearables.App"
       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
       RequestedTheme="Dark">

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <!-- Load WinUI resources -->
        <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
      </ResourceDictionary.MergedDictionaries>

      <!-- Watch palette: true black saves power on OLED watch faces -->
      <SolidColorBrush x:Key="WatchBackgroundBrush" Color="Black" />
      <SolidColorBrush x:Key="WatchSurfaceBrush" Color="#FF202124" />
      <SolidColorBrush x:Key="WatchCounterBrush" Color="#FF8AB4F8" />
      <SolidColorBrush x:Key="WatchWalkBrush" Color="#FF81C995" />
      <SolidColorBrush x:Key="WatchStopBrush" Color="#FFF28B82" />
      <SolidColorBrush x:Key="WatchSecondaryTextBrush" Color="#FFBDC1C6" />

      <!-- Full-width pill used by the launcher; tall enough for a fingertip -->
      <Style x:Key="WatchChipButtonStyle" TargetType="Button">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="MinHeight" Value="52" />
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="CornerRadius" Value="26" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Background" Value="{StaticResource WatchSurfaceBrush}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderThickness" Value="0" />
      </Style>

      <!-- Small round back button that sits at the top of the round screen -->
      <Style x:Key="WatchBackButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="18" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Background" Value="{StaticResource WatchSurfaceBrush}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderThickness" Value="0" />
      </Style>

    </ResourceDictionary>
  </Application.Resources>

</Application>
