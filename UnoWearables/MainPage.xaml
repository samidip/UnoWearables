<Page x:Class="UnoWearables.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource WatchBackgroundBrush}">

  <!-- Vertical scrolling only: horizontal swipes belong to Wear OS swipe-to-dismiss -->
  <ScrollViewer VerticalScrollBarVisibility="Hidden"
                HorizontalScrollMode="Disabled">
    <!-- Horizontal padding keeps content inside the circle on round watches -->
    <StackPanel MaxWidth="220"
                Padding="24,20"
                Spacing="8"
                VerticalAlignment="Center">

      <TextBlock Text="Uno Wear"
                 FontSize="14"
                 HorizontalAlignment="Center"
                 Foreground="{StaticResource WatchSecondaryTextBrush}" />

      <Button x:Name="CounterButton"
              AutomationProperties.AutomationId="CounterButton"
              Style="{StaticResource WatchChipButtonStyle}"
              Click="OnCounterClick">
        <StackPanel Orientation="Horizontal" Spacing="12">
          <Border Width="32" Height="32" CornerRadius="16"
                  Background="{StaticResource WatchCounterBrush}">
            <FontIcon Glyph="&#xE710;" FontSize="16" Foreground="Black" />
          </Border>
          <TextBlock Text="Counter" VerticalAlignment="Center" />
        </StackPanel>
      </Button>

      <Button x:Name="WalkButton"
              AutomationProperties.AutomationId="WalkButton"
              Style="{StaticResource WatchChipButtonStyle}"
              Click="OnWalkClick">
        <StackPanel Orientation="Horizontal" Spacing="12">
          <Border Width="32" Height="32" CornerRadius="16"
                  Background="{StaticResource WatchWalkBrush}">
            <FontIcon Glyph="&#xE805;" FontSize="16" Foreground="Black" />
          </Border>
          <TextBlock Text="Walk" VerticalAlignment="Center" />
        </StackPanel>
      </Button>

    </StackPanel>
  </ScrollViewer>
</Page>
